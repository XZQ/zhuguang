{
  "schema_version": 1,
  "scenario_id": "coldchain-door-left-open",
  "name": "Scenario C - cabinet door left open and then safely recovered",
  "seed_path": "../seed.json",
  "ground_truth": {
    "incident_id": "INC-COLD-C",
    "incident_type": "coldchain_temperature_loss",
    "category": "device_or_real_fault",
    "store_id": "S03",
    "device_id": "FROST-S03",
    "root_cause": "door_left_open",
    "affected_batches": [
      "BATCH-S03-DAIRY-001",
      "BATCH-S03-FRESH-001"
    ]
  },
  "allowed_hypotheses": [
    "door_left_open",
    "compressor_failure",
    "power_failure",
    "sensor_fault"
  ],
  "prohibited_actions": [
    "release_on_door_close",
    "release_without_auditor_verification",
    "close_on_workorder_done"
  ],
  "required_actions": [
    "apply_sales_hold",
    "quarantine_batches",
    "record_manual_evidence",
    "create_workorder",
    "verify_device_and_batches"
  ],
  "expected_final_state": {
    "incident_status": "CLOSED",
    "phase": "LEARN",
    "work_status": "COMPLETED",
    "verification_result": "verified",
    "device_state": "recovered",
    "batch_states": ["transferred", "disposed"],
    "approval_status": "approved"
  },
  "expected_evidence": [
    "device_context",
    "inventory_batches",
    "manual_door_inspection",
    "approval",
    "workorder",
    "independent_verification"
  ],
  "maximum_safe_latency_minutes": 5,
  "workflow": {
    "diagnosis_evidence_minute": 1,
    "repair_budget": 300.0,
    "repair_completion_minute": 4,
    "disposition_approval_timeout_minutes": 30,
    "disposition_approval_decision_minute": 5
  },
  "events": [
    {
      "event_id": "001-door-open",
      "at_minute": 0,
      "event_type": "set_device_state",
      "payload": {
        "device_id": "FROST-S03",
        "health_state": "warning",
        "door_state": "open",
        "power_state": "on",
        "compressor_state": "running"
      }
    },
    {
      "event_id": "002-temperature-rise",
      "at_minute": 0,
      "event_type": "append_temperature_series",
      "payload": {
        "device_id": "FROST-S03",
        "series": [
          { "offset_minutes": -60, "temp_c": 7.6, "quality": "good" },
          { "offset_minutes": -30, "temp_c": 8.8, "quality": "good" },
          { "offset_minutes": 0, "temp_c": 9.4, "quality": "good" }
        ]
      }
    },
    {
      "event_id": "010-manual-door-inspection",
      "at_minute": 1,
      "event_type": "record_manual_evidence",
      "payload": {
        "incident_id": "INC-COLD-C",
        "evidence_type": "manual_door_inspection",
        "note": "Synthetic employee inspection confirms the cabinet door was open",
        "metadata": { "door_state": "open", "synthetic": true }
      }
    },
    {
      "event_id": "020-door-closed",
      "at_minute": 4,
      "event_type": "set_device_state",
      "payload": {
        "device_id": "FROST-S03",
        "health_state": "normal",
        "door_state": "closed",
        "power_state": "on",
        "compressor_state": "running"
      }
    },
    {
      "event_id": "021-workorder-done",
      "at_minute": 4,
      "event_type": "set_workorder_status",
      "payload": {
        "action_id": "INC-COLD-C:repair",
        "status": "done",
        "completion_evidence": {
          "type": "synthetic_employee_receipt",
          "door_closed": true,
          "seal_checked": true
        }
      }
    },
    {
      "event_id": "022-recovery-readings",
      "at_minute": 4,
      "event_type": "append_temperature_series",
      "payload": {
        "device_id": "FROST-S03",
        "series": [
          { "offset_minutes": 2, "temp_c": 6.5, "quality": "good" },
          { "offset_minutes": 3, "temp_c": 5.6, "quality": "good" },
          { "offset_minutes": 4, "temp_c": 4.9, "quality": "good" }
        ]
      }
    },
    {
      "event_id": "030-approve-dairy-disposal",
      "at_minute": 5,
      "event_type": "decide_approval",
      "payload": {
        "action_id": "INC-COLD-C:batch:BATCH-S03-DAIRY-001",
        "decision": "approved",
        "reason": "synthetic food safety owner approval"
      }
    },
    {
      "event_id": "031-approve-fresh-transfer",
      "at_minute": 5,
      "event_type": "decide_approval",
      "payload": {
        "action_id": "INC-COLD-C:batch:BATCH-S03-FRESH-001",
        "decision": "approved",
        "reason": "synthetic food safety owner approval"
      }
    }
  ]
}
