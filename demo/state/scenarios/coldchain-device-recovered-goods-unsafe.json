{
  "schema_version": 1,
  "scenario_id": "coldchain-device-recovered-goods-unsafe",
  "name": "Scenario E - equipment recovers while goods remain quarantined",
  "seed_path": "../seed.json",
  "ground_truth": {
    "incident_id": "INC-COLD-E",
    "incident_type": "coldchain_temperature_loss",
    "store_id": "S03",
    "device_id": "FROST-S03",
    "root_cause": "compressor_failure",
    "affected_batches": [
      "BATCH-S03-DAIRY-001",
      "BATCH-S03-FRESH-001"
    ]
  },
  "allowed_hypotheses": [
    "compressor_failure",
    "power_failure",
    "door_left_open",
    "sensor_fault"
  ],
  "prohibited_actions": [
    "release_on_device_recovery",
    "release_without_auditor_verification",
    "close_on_workorder_done"
  ],
  "required_actions": [
    "apply_sales_hold",
    "quarantine_batches",
    "create_workorder",
    "verify_device_and_batches",
    "request_goods_disposition_approval"
  ],
  "expected_final_state": {
    "incident_status": "CONTAINED",
    "phase": "EXECUTE",
    "work_status": "WAITING_APPROVAL",
    "verification_result": "manual_review",
    "device_state": "recovered",
    "batch_states": ["quarantined"],
    "approval_status": "pending"
  },
  "expected_evidence": [
    "device_context",
    "inventory_batches",
    "approval",
    "workorder",
    "independent_verification"
  ],
  "maximum_safe_latency_minutes": 5,
  "workflow": {
    "repair_budget": 2500.0,
    "repair_approval_timeout_minutes": 2,
    "repair_approval_decision_minute": 1,
    "repair_completion_minute": 5,
    "disposition_approval_timeout_minutes": 30
  },
  "events": [
    {
      "event_id": "001-device-fault",
      "at_minute": 0,
      "event_type": "set_device_state",
      "payload": {
        "device_id": "FROST-S03",
        "health_state": "fault",
        "door_state": "closed",
        "power_state": "on",
        "compressor_state": "stalled"
      }
    },
    {
      "event_id": "002-temperature-rise",
      "at_minute": 0,
      "event_type": "append_temperature_series",
      "payload": {
        "device_id": "FROST-S03",
        "series": [
          { "offset_minutes": -60, "temp_c": 7.8 },
          { "offset_minutes": -30, "temp_c": 8.7 },
          { "offset_minutes": 0, "temp_c": 9.6 }
        ]
      }
    },
    {
      "event_id": "003-dairy-risk",
      "at_minute": 0,
      "event_type": "set_batch_safety",
      "payload": { "batch_id": "BATCH-S03-DAIRY-001", "safe_for_sale": false }
    },
    {
      "event_id": "004-fresh-risk",
      "at_minute": 0,
      "event_type": "set_batch_safety",
      "payload": { "batch_id": "BATCH-S03-FRESH-001", "safe_for_sale": false }
    },
    {
      "event_id": "010-approve-repair",
      "at_minute": 1,
      "event_type": "decide_approval",
      "payload": {
        "action_id": "INC-COLD-E:repair",
        "decision": "approved",
        "reason": "synthetic store manager approval"
      }
    },
    {
      "event_id": "020-workorder-done",
      "at_minute": 5,
      "event_type": "set_workorder_status",
      "payload": {
        "action_id": "INC-COLD-E:repair",
        "status": "done",
        "completion_evidence": {
          "type": "synthetic_vendor_receipt",
          "compressor_replaced": true
        }
      }
    },
    {
      "event_id": "021-device-recovered",
      "at_minute": 5,
      "event_type": "set_device_state",
      "payload": {
        "device_id": "FROST-S03",
        "health_state": "normal",
        "door_state": "closed",
        "power_state": "on",
        "compressor_state": "running"
      }
    },
    {
      "event_id": "022-recovery-readings",
      "at_minute": 5,
      "event_type": "append_temperature_series",
      "payload": {
        "device_id": "FROST-S03",
        "series": [
          { "offset_minutes": 3, "temp_c": 6.2 },
          { "offset_minutes": 4, "temp_c": 5.4 },
          { "offset_minutes": 5, "temp_c": 4.8 }
        ]
      }
    }
  ]
}
