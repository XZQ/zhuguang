  "anchor_time": "2026-08-28T09:00:00+08:00",
  "baseline_suite_id": "dianxun-p0-coldchain-v1",
  "findings": [
    {
      "interpretation": "独立验证是事件管理层的安全前提;没有它,关闭决定与事实脱钩。MCP 工具层的 release_guard 构成第二道防线,即使管线退化也不放行实物。",
      "observed": "5/6 场景被自我宣告关闭(基线错误关闭 0 起);场景 E 在设备恢复但商品处置未闭环时,尝试放行 2 个未闭环批次,5 次放行全部被审批层或 MCP release_guard(verifier 必须是 Auditor)拦截,不安全批次实际放行 0 起;场景 B 出现 2 起放行/停售状态不一致(商品已准放行但停售未解除,过度遏制)。",
      "title": "移除 Auditor 独立验证:执行者自证成功",
      "variant": "no_auditor"
    },
    {
      "interpretation": "角色身份是写入路径的硬前提;单一身份的 Agent 连停售遏制都无法执行,系统以拒动方式降级保安全(fail-safe by refusal)。",
      "observed": "6 次受控写全部被 Policy 拒绝(allowed_actors 不含 SingleAgent),0/6 场景完成遏制,事件停留在 OPEN。",
      "title": "单一 Agent 身份:受控写在 Policy 层被拒",
      "variant": "single_agent"
    },
    {
      "interpretation": "诊断质量决定维修正确性与成本;误判时下游遏制/审批/验证层仍保证最终安全,但错误工单在真实门店意味着误修、浪费与故障未除。",
      "observed": "Top-1 命中 4/6(基线 6/6),错派工单 2 张(B 把传感器故障误判为压缩机故障、C 把门未关误判为压缩机故障);安全违规 0 起。",
      "title": "静态先验替代证据关联诊断",
      "variant": "rule_only"
    }
  ],
  "methodology": {
    "counterfactuals": "attempted_unsafe_release_batches counts batches whose disposition was not terminal when a variant tried to release their holds; whether the release physically succeeded is reported separately as dangerous_release_batches",
    "llm": "not called; latency/token/cost deltas need the external AgentTeams runtime",
    "state": "fresh temporary SQLite database per scenario and variant",
    "time": "scenario virtual clock anchored by demo/state/seed.json"
  },
