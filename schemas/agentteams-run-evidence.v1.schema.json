{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTeams runtime evidence bundle",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_kind",
    "capture_status",
    "captured_at",
    "agentteams_version",
    "package_source_commit",
    "package_sha256",
    "runtime",
    "resources",
    "skill_loads",
    "security_checks",
    "runs"
  ],
  "properties": {
    "schema_version": { "const": "1.3" },
    "evidence_kind": { "const": "agentteams_runtime" },
    "capture_status": { "const": "observed" },
    "captured_at": { "type": "string", "format": "date-time" },
    "agentteams_version": { "type": "string", "minLength": 1 },
    "package_source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "resources": {
      "type": "object",
      "required": ["manager", "team", "workers"],
      "properties": {
        "manager": { "$ref": "#/$defs/resource" },
        "team": { "$ref": "#/$defs/resource" },
        "workers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "skill_loads": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "worker",
          "skill",
          "version",
          "skill_digest",
          "package_sha256",
          "loaded_at",
          "evidence_ref"
        ],
        "properties": {
          "worker": { "type": "string" },
          "skill": { "type": "string" },
          "version": { "type": "string" },
          "skill_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "loaded_at": { "type": "string", "format": "date-time" },
          "evidence_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "security_checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["check", "expected", "observed", "at", "evidence_ref"],
        "properties": {
          "check": { "type": "string" },
          "expected": {},
          "observed": {},
          "at": { "type": "string", "format": "date-time" },
          "evidence_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "required": [
        "manager_runtime",
        "worker_runtime",
        "model",
        "provider",
        "credential_source_type",
        "usage_status",
        "evidence_ref"
      ],
      "properties": {
        "manager_runtime": { "type": "string", "minLength": 1 },
        "worker_runtime": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "credential_source_type": {
          "enum": ["environment", "gateway", "kubernetes_secret", "external_secret_manager"]
        },
        "usage_status": { "enum": ["measured", "not_measured"] },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    },
    "resource": {
      "type": "object",
      "required": ["name", "status", "evidence_ref"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "scenario_id",
        "branch",
        "project_id",
        "source_room_id",
        "incident_id",
        "trace_id",
        "coordination",
        "handoffs",
        "tool_calls",
        "approval",
        "final_state",
        "trace_artifact"
      ],
      "properties": {
        "scenario_id": { "type": "string" },
        "branch": { "enum": ["success", "failure"] },
        "project_id": { "type": "string", "minLength": 1 },
        "source_room_id": { "type": "string", "minLength": 1 },
        "incident_id": { "type": "string" },
        "trace_id": { "type": "string" },
        "coordination": { "$ref": "#/$defs/coordination" },
        "handoffs": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "phase",
              "task_id",
              "message_id",
              "at",
              "evidence_ref"
            ],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "phase": { "type": "string" },
              "task_id": { "type": "string", "minLength": 1 },
              "message_id": { "type": "string" },
              "at": { "type": "string", "format": "date-time" },
              "evidence_ref": { "type": "string", "minLength": 1 }
            }
          }
        },
        "tool_calls": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "worker",
              "skill",
              "skill_version",
              "skill_digest",
              "tool",
              "request_id",
              "incident_id",
              "trace_id",
              "authenticated_actor",
              "authentication_mode",
              "auth_evidence_ref",
              "at",
              "ok",
              "partial",
              "evidence_ref"
            ],
            "properties": {
              "worker": { "type": "string" },
              "skill": { "type": "string" },
              "skill_version": { "type": "string" },
              "skill_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "tool": { "type": "string" },
              "request_id": { "type": "string" },
              "incident_id": { "type": "string" },
              "trace_id": { "type": "string" },
              "authenticated_actor": {
                "enum": ["Sentry", "Diagnoser", "Executor", "Auditor"]
              },
              "authentication_mode": { "const": "actor_bound" },
              "auth_evidence_ref": { "type": "string", "minLength": 1 },
              "at": { "type": "string", "format": "date-time" },
              "ok": { "type": "boolean" },
              "partial": { "type": "boolean" },
              "audit_ref": {},
              "evidence_ref": { "type": "string" }
            }
          }
        },
        "approval": {
          "type": "object",
          "required": ["status", "actor_type", "decision_id", "at", "evidence_ref"],
          "properties": {
            "status": { "type": "string" },
            "actor_type": { "type": "string" },
            "decision_id": { "type": "string" },
            "at": { "type": "string", "format": "date-time" },
            "evidence_ref": { "type": "string", "minLength": 1 }
          }
        },
        "final_state": {
          "type": "object",
          "required": [
            "incident_status",
            "work_status",
            "sales_hold_status",
            "observed_at",
            "evidence_ref"
          ],
          "properties": {
            "incident_status": { "type": "string" },
            "work_status": { "type": "string" },
            "sales_hold_status": { "type": "string" },
            "observed_at": { "type": "string", "format": "date-time" },
            "evidence_ref": { "type": "string", "minLength": 1 }
          }
        },
        "trace_artifact": {
          "type": "object",
          "required": ["uri", "sha256", "redacted"],
          "properties": {
            "uri": { "type": "string" },
            "sha256": {
              "type": "string",
              "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
            },
            "redacted": { "const": true }
          }
        }
      }
    },
    "coordination": {
      "type": "object",
      "required": [
        "tenant_id",
        "context_version",
        "expires_at",
        "resumed_from_checkpoint",
        "resume_evidence_ref",
        "assignments",
        "checkpoints"
      ],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "context_version": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "resumed_from_checkpoint": { "type": "boolean" },
        "resume_evidence_ref": { "type": ["string", "null"] },
        "assignments": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/assignment" }
        },
        "checkpoints": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/checkpoint" }
        }
      }
    },
    "assignment": {
      "type": "object",
      "required": [
        "assignment_id",
        "phase",
        "worker",
        "attempt",
        "status",
        "assigned_at",
        "lease_expires_at",
        "heartbeat_at",
        "evidence_ref"
      ],
      "properties": {
        "assignment_id": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "worker": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["expired", "succeeded"] },
        "assigned_at": { "type": "string", "format": "date-time" },
        "lease_expires_at": { "type": "string", "format": "date-time" },
        "heartbeat_at": { "type": "string", "format": "date-time" },
        "predecessor_assignment_id": { "type": ["string", "null"] },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "phase",
        "assignment_id",
        "context_version",
        "at",
        "evidence_refs"
      ],
      "properties": {
        "phase": { "type": "string", "minLength": 1 },
        "assignment_id": { "type": "string", "minLength": 1 },
        "context_version": { "type": "integer", "minimum": 1 },
        "at": { "type": "string", "format": "date-time" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
