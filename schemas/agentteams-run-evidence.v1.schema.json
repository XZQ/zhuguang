{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTeams runtime evidence bundle",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_kind",
    "capture_status",
    "captured_at",
    "agentteams_version",
    "package_sha256",
    "resources",
    "skill_loads",
    "security_checks",
    "runs"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "evidence_kind": { "const": "agentteams_runtime" },
    "capture_status": { "const": "observed" },
    "captured_at": { "type": "string", "minLength": 1 },
    "agentteams_version": { "type": "string", "minLength": 1 },
    "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resources": {
      "type": "object",
      "required": ["manager", "team", "workers"],
      "properties": {
        "manager": { "$ref": "#/$defs/resource" },
        "team": { "$ref": "#/$defs/resource" },
        "workers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "skill_loads": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "worker",
          "skill",
          "version",
          "skill_digest",
          "package_sha256",
          "loaded_at"
        ],
        "properties": {
          "worker": { "type": "string" },
          "skill": { "type": "string" },
          "version": { "type": "string" },
          "skill_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "loaded_at": { "type": "string" }
        }
      }
    },
    "security_checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["check", "expected", "observed", "evidence_ref"],
        "properties": {
          "check": { "type": "string" },
          "expected": {},
          "observed": {},
          "evidence_ref": { "type": "string" }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": ["name", "status", "evidence_ref"],
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "evidence_ref": { "type": "string" }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "scenario_id",
        "branch",
        "incident_id",
        "trace_id",
        "handoffs",
        "tool_calls",
        "approval",
        "final_state",
        "trace_artifact"
      ],
      "properties": {
        "scenario_id": { "type": "string" },
        "branch": { "enum": ["success", "failure"] },
        "incident_id": { "type": "string" },
        "trace_id": { "type": "string" },
        "handoffs": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["from", "to", "phase", "message_id", "at"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "phase": { "type": "string" },
              "message_id": { "type": "string" },
              "at": { "type": "string" }
            }
          }
        },
        "tool_calls": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "worker",
              "skill",
              "skill_version",
              "skill_digest",
              "tool",
              "request_id",
              "incident_id",
              "trace_id",
              "ok",
              "partial",
              "evidence_ref"
            ],
            "properties": {
              "worker": { "type": "string" },
              "skill": { "type": "string" },
              "skill_version": { "type": "string" },
              "skill_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "tool": { "type": "string" },
              "request_id": { "type": "string" },
              "incident_id": { "type": "string" },
              "trace_id": { "type": "string" },
              "ok": { "type": "boolean" },
              "partial": { "type": "boolean" },
              "audit_ref": {},
              "evidence_ref": { "type": "string" }
            }
          }
        },
        "approval": {
          "type": "object",
          "required": ["status", "actor_type", "decision_id", "evidence_ref"],
          "properties": {
            "status": { "type": "string" },
            "actor_type": { "type": "string" },
            "decision_id": { "type": "string" },
            "evidence_ref": { "type": "string" }
          }
        },
        "final_state": {
          "type": "object",
          "required": ["incident_status", "work_status", "sales_hold_status"],
          "properties": {
            "incident_status": { "type": "string" },
            "work_status": { "type": "string" },
            "sales_hold_status": { "type": "string" }
          }
        },
        "trace_artifact": {
          "type": "object",
          "required": ["uri", "sha256", "redacted"],
          "properties": {
            "uri": { "type": "string" },
            "sha256": {
              "type": "string",
              "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
            },
            "redacted": { "const": true }
          }
        }
      }
    }
  }
}
