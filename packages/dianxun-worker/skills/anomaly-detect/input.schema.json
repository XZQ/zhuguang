{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "anomaly-detect input",
  "type": "object",
  "additionalProperties": false,
  "required": ["store_id", "device_id", "alarm_max_c"],
  "properties": {
    "store_id": { "type": "string", "minLength": 1 },
    "device_id": { "type": "string", "minLength": 1 },
    "alarm_max_c": { "type": "number" },
    "minimum_over_samples": { "type": "integer", "minimum": 1, "default": 2 }
  }
}
