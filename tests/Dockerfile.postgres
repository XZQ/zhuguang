FROM pgvector/pgvector@sha256:ccc6e83d6e35e931dc7c5def2022729d5a6c370318d099181995567ff1fb4d6b

# Backup clients are test tooling; do not expand the deployed MCP image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/test-venv \
    && /opt/test-venv/bin/pip install --no-cache-dir 'psycopg[binary]==3.3.5' \
    && mkdir -p /var/lib/dianxun \
    && chown 10001:10001 /var/lib/dianxun
ENV PATH=/opt/test-venv/bin:/usr/lib/postgresql/16/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["python"]
